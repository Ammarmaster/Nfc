# ==========================================
# TapReview Smart NFC & Dynamic QR Platform
# Environment Configuration
# ==========================================

# 1. Custom Domain for QR Codes & NFC Links:
# If left blank, it automatically detects the current browser host dynamically (e.g. nfc.pages.dev, yourdomain.com, or localhost:5173).
# When you have a custom domain, set it here (without https://):
# Example: VITE_APP_DOMAIN=review.myrestaurant.com
VITE_APP_DOMAIN=

# 2. Admin Portal Authentication:
# Set your master password/key to protect the admin dashboard from unauthorized access.
# If someone visits the dashboard, this password is required to manage stands and settings.
VITE_ADMIN_PASSWORD=admin123

# 3. AI Review Assistant Key (Optional):
# Google Gemini API key if you wish to use live LLM review drafts instead of the built-in smart template engine.
# Free at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
